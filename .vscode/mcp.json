{
  "inputs": [
    {
      "id": "supabase-project-ref",
      "type": "promptString",
      "description": "Supabase project reference (required for supabase MCP)"
    },
    {
      "id": "supabase-token",
      "type": "promptString",
      "description": "Supabase access token (required for supabase MCP)",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "tools": ["*"]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=vbrbrsvhbmmxdgcdskpj&read_only=true&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cfeedback%2Cnotebooks"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "tools": ["browser_*"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "tools": ["query-docs", "resolve-library-id"]
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com",
      "tools": ["*"]
    },
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp",
      "tools": ["*"]
    },
    "context-cutter": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "context-cutter-mcp"],
      "tools": ["*"]
    },
    "graphify": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "graphifyy[mcp]",
        "python",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ],
      "tools": ["*"]
    }
  }
}

{
  "name": "WJDR",
  "image": "mcr.microsoft.com/devcontainers/typescript-node",

  "features": {
    "ghcr.io/devcontainers/features/copilot-cli:1.1.4": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers-extra/features/uv:1": {}
  },

  "runArgs": [
    "--init",
    "--ipc=host"
  ],

  "postCreateCommand": {
    "npm": "npm install && npx playwright install --with-deps chromium",
    "rtk": "curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh",
    "prek": "curl -LsSf https://github.com/j178/prek/releases/download/v0.5.5/prek-installer.sh | sh && ~/.local/bin/prek install"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "files.eol": "\n"
      },
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "github.copilot-chat",
        "ms-python.python",
        "tamasfe.even-better-toml",
        "GitHub.vscode-pull-request-github",
        "webpro.vscode-knip",
        "ms-playwright.playwright"
      ]
    }
  }
}
